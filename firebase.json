{
  "firestore": [
    {
      "database": "blog",
      "rules": "firestore.blog.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "blog",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "target": "blog",
      "public": "deploy/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "rewrites": [
        {
          "source": "**",
          "destination": "/post.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=3600"
            }
          ]
        },
        {
          "source": "robots.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ]
        },
        {
          "source": "sitemap.xml",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/xml; charset=utf-8"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Link",
              "value": "</sitemap.xml>; rel=\"sitemap\", </posts-index.json>; rel=\"alternate\"; type=\"application/json\""
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Link",
              "value": "</sitemap.xml>; rel=\"sitemap\", </posts-index.json>; rel=\"alternate\"; type=\"application/json\""
            }
          ]
        },
        {
          "source": "posts-index.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "max-age=3600"
            }
          ]
        },
        {
          "source": "llms.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Signal",
              "value": "ai-train=no, search=yes, ai-input=no"
            }
          ]
        }
      ]
    }
  ]
}
