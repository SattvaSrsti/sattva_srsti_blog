rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Catalog admin: bootstrap email now; scale with custom claim admin:true later.
    function isCatalogAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sattvasrsti@gmail.com'
        || request.auth.token.admin == true
      );
    }

    function isPublishedCatalogDoc() {
      return resource.data.get('status', '') == 'published';
    }

    function recipeIsPublished(recipeId) {
      return get(/databases/$(database)/documents/recipes_v2/$(recipeId))
        .data.get('status', '') == 'published';
    }

    function dishFamilyIsPublished(familyId) {
      return familyId == '_catalog'
        || get(/databases/$(database)/documents/dish_families/$(familyId))
          .data.get('status', '') == 'published';
    }

    // Signed-in users read all catalog docs; anonymous reads published only (blog, export, SEO).
    function canReadPublishedCatalog() {
      return isSignedIn() || isPublishedCatalogDoc();
    }

    function clientMayUpdateCreditFields() {
      let newCredit = request.resource.data.get('creditBalance', null);
      let oldCredit = resource.data.get('creditBalance', null);
      let creditOk = newCredit == null || newCredit == oldCredit;

      let newLimit = request.resource.data.get('aiCreditLimit', null);
      let oldLimit = resource.data.get('aiCreditLimit', null);
      let limitOk = newLimit == null || newLimit == oldLimit;

      let newSeeded = request.resource.data.get('creditsSeededAt', null);
      let oldSeeded = resource.data.get('creditsSeededAt', null);
      let seededOk = newSeeded == null || newSeeded == oldSeeded;

      return creditOk && limitOk && seededOk;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['creditBalance', 'aiCreditLimit', 'creditsSeededAt']);

      allow update: if isOwner(uid)
        && clientMayUpdateCreditFields();

      allow delete: if false;

      // Server-owned billing / usage (client read-only)
      match /subscriptions/{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /subscription_history/{paymentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /ai_usage/{monthId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /realtime_usage/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // User-owned profile domains (singleton docs under each collection)
      match /taste_profile/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /health_profile/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /nutrition_profile/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /cooking_preferences/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /ai_preferences/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /dashboard_preferences/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /body_metrics_history/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /nutrition_target_history/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /diet_plan_state/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /diet_plans/{planId} {
        allow read, write: if isOwner(uid);

        match /days/{dayId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /meal_logs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /meal_log_events/{eventId} {
        allow read, write: if isOwner(uid);
      }

      match /diet_dashboard/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /diet_adherence/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /weekly_summaries/{weekId} {
        allow read, write: if isOwner(uid);
      }

      match /hungry_preferences/{docId} {
        allow read, write: if isOwner(uid);
      }

      // User-owned list / activity data
      match /user_pantry/{itemId} {
        allow read, write: if isOwner(uid);
      }

      match /shopping_list/{itemId} {
        allow read, write: if isOwner(uid);
      }

      match /saved_recipes/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      match /recipe_views/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      match /hungry_signals/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      match /hungry_time_stats/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /cooking_history/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /recipe_collections/{collectionId} {
        allow read, write: if isOwner(uid);
      }

      match /kitchen_templates/{templateId} {
        allow read, write: if isOwner(uid);
      }

      match /ai_conversations/{conversationId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /recipe_customizations/{recipeId} {
        allow read, write: if isOwner(uid);

        match /versions/{versionId} {
          allow read, write: if isOwner(uid);
        }
      }

      // Legacy e-commerce paths (read/write for signed-in owner)
      match /address/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /wishlist/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /orders/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /cart/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /bakra/{document=**} {
      allow read, write: if false;
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /admin/{doc} {
      allow read: if isSignedIn();
      allow write: if isCatalogAdmin();
    }

    match /ai_models/{modelId} {
      allow read: if isSignedIn();
      allow write: if isCatalogAdmin();
    }

    match /knowledge_gaps/{gapId} {
      allow read: if isSignedIn();
      allow write: if isCatalogAdmin();
    }

    match /app_kitchen_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isCatalogAdmin();
    }

    match /recipe_search_index/{recipeId} {
      allow read: if canReadPublishedCatalog();
      allow write: if false;
    }

    match /recipes_v2/{recipeId} {
      allow read: if canReadPublishedCatalog();
      allow write: if isCatalogAdmin();

      match /comments/{userId} {
        allow read: if isSignedIn() || recipeIsPublished(recipeId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /{subcollection}/{docId} {
        allow read: if isSignedIn() || recipeIsPublished(recipeId);
        allow write: if isCatalogAdmin();
      }
    }

    match /dish_families/{familyId} {
      allow read: if isSignedIn() || dishFamilyIsPublished(familyId);
      allow write: if isCatalogAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn() || dishFamilyIsPublished(familyId);
        allow write: if isCatalogAdmin();
      }
    }

    // Nested recipes_v2/{id}/... rules do not apply to collectionGroup() queries.
    // Path constraints here would reject the query (rules are not filters).
    match /{path=**}/identity_ingredient_ids/{document} {
      allow read: if isSignedIn();
      allow write: if isCatalogAdmin();
    }

    // Ingredient reference catalog — public read for blog/export; writes admin-only.
    match /all_ingredients/{document=**} {
      allow read: if true;
      allow write: if isCatalogAdmin();
    }

    // Blog marketing layer — public read; writes via Admin SDK only (pipeline / scripts).
    match /blog_posts/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
