rules_version = '2';

// Public blog may read only blog_posts (capped teaser). It must not query recipes_v2.
// App: anonymous recipes_v2 reads are published-only; list queries must
// where('status', '==', 'published'). Drafts stay signed-in. Writes: catalog admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCatalogAdmin() {
      return isSignedIn() && (
        request.auth.token.catalogAdmin == true
        || request.auth.token.admin == true
      );
    }

    function recipeIsPublished(recipeId) {
      return get(/databases/$(database)/documents/recipes_v2/$(recipeId)).data.status == 'published';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['creditBalance', 'aiCreditLimit', 'creditsSeededAt']);

      allow update: if isOwner(uid)
        && clientMayUpdateCreditFields();

      match /subscriptions/{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /subscription_history/{paymentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /ai_usage/{monthId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    function clientMayUpdateCreditFields() {
      let newCredit = request.resource.data.get('creditBalance', null);
      let oldCredit = resource.data.get('creditBalance', null);
      let creditOk = newCredit == null || newCredit == oldCredit;

      let newLimit = request.resource.data.get('aiCreditLimit', null);
      let oldLimit = resource.data.get('aiCreditLimit', null);
      let limitOk = newLimit == null || newLimit == oldLimit;

      let newSeeded = request.resource.data.get('creditsSeededAt', null);
      let oldSeeded = resource.data.get('creditsSeededAt', null);
      let seededOk = newSeeded == null || newSeeded == oldSeeded;

      return creditOk && limitOk && seededOk;
    }

    match /bakra/{document=**} {
      allow read, write: if false;
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /admin/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /ai_models/{modelId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /recipes_v2/{recipeId} {
      allow read: if resource.data.status == 'published' || isSignedIn();
      allow write: if isCatalogAdmin();

      match /{document=**} {
        allow read: if recipeIsPublished(recipeId) || isSignedIn();
        allow write: if isCatalogAdmin();
      }
    }

    match /all_ingredients/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Blog marketing layer — public read; writes via Admin SDK only (sync script / pipeline)
    match /blog_posts/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
